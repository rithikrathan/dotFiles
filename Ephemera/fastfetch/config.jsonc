{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/Ephemera/fastfetch/ascii/arch.txt",
        "padding": {
            "top": 1,
            "right": 6
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "red"
        }
    },
    "modules": [
        "break",
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "kernel",
            "key": " Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },
        "break",
        {
            "type": "custom",
            "format": "     \u001b[3;91m\"And when your sorrow is comforted\u001b[0m"
        },
        {
            "type": "custom",
            "format": "  \u001b[3;91myou will be content that you have known me.\"\u001b[0m"
        }
    ]
}
